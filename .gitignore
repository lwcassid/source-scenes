# sighted-iteration artifacts (regenerated on demand)
night-circuit-preview.html
scratchshots/
# harness deps for tools/shot*.mjs (install locally: npm i playwright-core)
node_modules/
package.json
package-lock.json
# electron/ is a real, committed app (the show-runner wrapper) — its own
# package.json/lockfile are tracked even though the repo-root ones above
# aren't; only its node_modules stays ignored (node_modules/ above already
# matches at any depth).
!electron/package.json
!electron/package-lock.json

# agent worktrees (transient, never part of the site)
.claude/worktrees/
.verify-stamp
.claude/.cache/
tools/__pycache__/
